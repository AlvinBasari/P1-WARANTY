<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CustomerApp.ViewModels"
             x:Class="CustomerApp.Views.WarrantyView"
             x:DataType="vm:WarrantyViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Border Padding="24,18,24,24" HorizontalAlignment="Stretch">
            <StackPanel Spacing="16">
                <!-- Toast Notification Banner for Copy / Activation Actions -->
                <Border IsVisible="{Binding CopyToast, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                        Background="{DynamicResource VantageAccentSubtleBrush}" BorderBrush="{DynamicResource VantageAccentBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="14,10" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{StaticResource IconCheck}" Foreground="{DynamicResource VantageAccentBrush}" Width="14" Height="14" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding CopyToast}" Foreground="White" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Unregistered Device Warning & Activation Banner (Shown when machine not yet in DB) -->
                <Border IsVisible="{Binding !IsDeviceRegistered}"
                        Background="{DynamicResource VantageAmberSubtleBrush}" BorderBrush="{DynamicResource VantageAmberBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="20">
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                        <PathIcon Grid.Column="0" Grid.Row="0" Data="{StaticResource IconAlert}" Foreground="{DynamicResource VantageAmberBrush}"
                                  Width="24" Height="24" Margin="0,2,16,0" VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1" Grid.Row="0" Spacing="4">
                            <TextBlock Text="Perangkat Komputer Ini Belum Terdaftar dalam Database PT JTS" FontSize="15" FontWeight="Bold" Foreground="White" />
                            <TextBlock Text="Unit ini belum terhubung dengan garansi resmi. Jika Anda membeli unit ini dari PT Jaya Teknologi Solusi, silakan masukkan Serial Number atau Token QR dari stiker fisik yang ditempel pada casing unit."
                                       FontSize="12" Foreground="{DynamicResource VantageTextMutedBrush}" TextWrapping="Wrap" LineHeight="18" />
                        </StackPanel>

                        <!-- Activation Form Input -->
                        <StackPanel Grid.Column="1" Grid.Row="1" Margin="0,14,0,0" Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Grid.Column="0" Text="{Binding ClaimTokenInput, Mode=TwoWay}"
                                         Watermark="Masukkan Token QR stiker (misal: qr-demo-lenovo-002) atau Serial Number..."
                                         FontFamily="Consolas,Monospace" FontSize="13" Margin="0,0,10,0" />
                                <Button Grid.Column="1" Command="{Binding ActivateWithTokenCommand}"
                                        IsEnabled="{Binding !IsActivating}"
                                        Background="{DynamicResource VantageAccentBrush}" Foreground="White"
                                        Padding="18,10" CornerRadius="8" FontWeight="Bold" FontSize="13">
                                    <TextBlock Text="Aktivasi Garansi" />
                                </Button>
                            </Grid>

                            <!-- Error Message -->
                            <TextBlock Text="{Binding ActivationError}" IsVisible="{Binding ActivationError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                       FontSize="12" Foreground="{DynamicResource VantageFaultBrush}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ══════════════════════════════════════════════════════════ -->
                <!-- TOP ROW: Hero Device Specs (Left) + 4 Live Metric Dials    -->
                <!-- ══════════════════════════════════════════════════════════ -->
                <Grid ColumnDefinitions="1.3*,1*,1*">

                    <!-- ============================================== -->
                    <!-- COL 0: Hero Device Specification Card          -->
                    <!-- ============================================== -->
                    <Border Grid.Column="0"
                            Background="{DynamicResource VantageCardBrush}" BorderBrush="{DynamicResource VantageBorderBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="22" Margin="0,0,14,0">
                        <Grid RowDefinitions="Auto,*,Auto">
                            <!-- Device Model Name & Physical Status -->
                            <StackPanel Grid.Row="0" Spacing="6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding Device.Model, FallbackValue={Binding LocalModel}}"
                                               FontSize="18" FontWeight="Bold" Foreground="{DynamicResource VantageTextBrush}"
                                               TextWrapping="Wrap" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Background="{DynamicResource VantageAccentSubtleBrush}"
                                            BorderBrush="{DynamicResource VantageAccentBrush}" BorderThickness="1"
                                            CornerRadius="10" Padding="10,4" VerticalAlignment="Center" Margin="8,0,0,0">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <PathIcon Data="{StaticResource IconShield}" Foreground="{DynamicResource VantageAccentLightBrush}" Width="11" Height="11" VerticalAlignment="Center" />
                                            <TextBlock Text="GARANSI RESMI PT JTS" FontSize="10" FontWeight="Bold" FontFamily="Consolas,Monospace" Foreground="{DynamicResource VantageAccentLightBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <Separator Background="{DynamicResource VantageBorderBrush}" Height="1" Margin="0,10,0,12" />
                            </StackPanel>

                            <!-- Specification Rows with Copy Buttons -->
                            <StackPanel Grid.Row="1" Spacing="12">
                                <!-- Row 1: Serial number -->
                                <Grid ColumnDefinitions="100,*,Auto">
                                    <TextBlock Grid.Column="0" Text="Serial Number" FontSize="12" Foreground="{DynamicResource VantageTextMutedBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Device.SerialNumber, FallbackValue={Binding LocalSerial}}"
                                               FontFamily="Consolas,Monospace" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource VantageTextBrush}" VerticalAlignment="Center" Margin="4,0,8,0" TextTrimming="CharacterEllipsis" />
                                    <Button Grid.Column="2" Command="{Binding CopySerialCommand}"
                                            Background="{DynamicResource VantageBgBrush}" BorderBrush="{DynamicResource VantageBorderBrush}" BorderThickness="1"
                                            CornerRadius="6" Padding="6,3" FontSize="11" Foreground="{DynamicResource VantageTextMutedBrush}"
                                            ToolTip.Tip="Salin Serial Number">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <PathIcon Data="{StaticResource IconCopy}" Foreground="{DynamicResource VantageTextMutedBrush}" Width="10" Height="10" VerticalAlignment="Center" />
                                            <TextBlock Text="Salin" VerticalAlignment="Center" FontSize="11" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Row 2: BIOS Hardware ID -->
                                <Grid ColumnDefinitions="100,*,Auto">
                                    <TextBlock Grid.Column="0" Text="Hardware ID" FontSize="12" Foreground="{DynamicResource VantageTextMutedBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Device.HardwareId, FallbackValue={Binding LocalHardwareId}}"
                                               FontFamily="Consolas,Monospace" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource VantageTextBrush}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="4,0,8,0" />
                                    <Button Grid.Column="2" Command="{Binding CopyHardwareIdCommand}"
                                            Background="{DynamicResource VantageBgBrush}" BorderBrush="{DynamicResource VantageBorderBrush}" BorderThickness="1"
                                            CornerRadius="6" Padding="6,3" FontSize="11" Foreground="{DynamicResource VantageTextMutedBrush}"
                                            ToolTip.Tip="Salin BIOS / Hardware ID">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <PathIcon Data="{StaticResource IconCopy}" Foreground="{DynamicResource VantageTextMutedBrush}" Width="10" Height="10" VerticalAlignment="Center" />
                                            <TextBlock Text="Salin" VerticalAlignment="Center" FontSize="11" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Row 3: BIOS version -->
                                <Grid ColumnDefinitions="100,*,Auto">
                                    <TextBlock Grid.Column="0" Text="Versi BIOS" FontSize="12" Foreground="{DynamicResource VantageTextMutedBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding BiosVersion, FallbackValue='M16KT37A'}"
                                               FontFamily="Consolas,Monospace" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource VantageTextBrush}" VerticalAlignment="Center" Margin="4,0,8,0" TextTrimming="CharacterEllipsis" />
                                    <Button Grid.Column="2" Command="{Binding CopyBiosVersionCommand}"
                                            Background="{DynamicResource VantageBgBrush}" BorderBrush="{DynamicResource VantageBorderBrush}" BorderThickness="1"
                                            CornerRadius="6" Padding="6,3" FontSize="11" Foreground="{DynamicResource VantageTextMutedBrush}"
                                            ToolTip.Tip="Salin Versi BIOS">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <PathIcon Data="{StaticResource IconCopy}" Foreground="{DynamicResource VantageTextMutedBrush}" Width="10" Height="10" VerticalAlignment="Center" />
                                            <TextBlock Text="Salin" VerticalAlignment="Center" FontSize="11" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <!-- Bottom Action Buttons of Hero Card -->
                            <StackPanel Grid.Row="2" Spacing="8" Margin="0,16,0,0">
                                <WrapPanel Orientation="Horizontal">
                                    <!-- Button 1: Download Image PNG -->
                                    <Button Command="{Binding DownloadWarrantyCardImageCommand}"
                                            Background="{DynamicResource VantageCardHoverBrush}" BorderBrush="{DynamicResource VantageBorderBrush}" BorderThickness="1"
                                            CornerRadius="8" Padding="12,7" FontWeight="SemiBold" FontSize="11" Margin="0,0,8,6">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <PathIcon Data="{StaticResource IconShield}" Foreground="{DynamicResource VantageAccentBrush}" Width="12" Height="12" VerticalAlignment="Center" />
                                            <TextBlock Text="Unduh Kartu (PNG)" Foreground="{DynamicResource VantageTextBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Button 2: Print / PDF Certificate -->
                                    <Button Command="{Binding ExportWarrantyCertificateCommand}"
                                            Background="{DynamicResource VantageCardHoverBrush}" BorderBrush="{DynamicResource VantageBorderBrush}" BorderThickness="1"
                                            CornerRadius="8" Padding="12,7" FontWeight="SemiBold" FontSize="11" Margin="0,0,8,6">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <PathIcon Data="{StaticResource IconHistory}" Foreground="{DynamicResource VantageAccentBrush}" Width="12" Height="12" VerticalAlignment="Center" />
                                            <TextBlock Text="Cetak PDF" Foreground="{DynamicResource VantageTextBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Button 3: Copy Format for CS / WhatsApp -->
                                    <Button Command="{Binding CopyCsSummaryCommand}"
                                            Background="{DynamicResource VantageCardHoverBrush}" BorderBrush="{DynamicResource VantageBorderBrush}" BorderThickness="1"
                                            CornerRadius="8" Padding="12,7" FontWeight="SemiBold" FontSize="11" Margin="0,0,8,6"
                                            ToolTip.Tip="Salin seluruh spesifikasi perangkat dalam format pesan rapi untuk dikirimkan ke CS / WhatsApp">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <PathIcon Data="{StaticResource IconCopy}" Foreground="{DynamicResource VantageAccentLightBrush}" Width="12" Height="12" VerticalAlignment="Center" />
                                            <TextBlock Text="Salin Format CS" Foreground="{DynamicResource VantageTextBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Button 4: Go to Dedicated Diagnostic Page -->
                                    <Button Command="{Binding GoToDiagnosticCommand}"
                                            Background="{DynamicResource VantageAccentBrush}" Foreground="White"
                                            CornerRadius="8" Padding="12,7" FontWeight="Bold" FontSize="11" Margin="0,0,0,6">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <PathIcon Data="{StaticResource IconCpu}" Foreground="White" Width="12" Height="12" VerticalAlignment="Center" />
                                            <TextBlock Text="Panel Diagnostik PC" Foreground="White" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ============================================== -->
                    <!-- COL 1: Kondisi Unit & Penyimpanan Disk         -->
                    <!-- ============================================== -->
                    <Grid Grid.Column="1" RowDefinitions="*,*" Margin="0,0,14,0">
                        <!-- Card 1: Kondisi Unit (Clickable to Tracking) -->
                        <Button Grid.Row="0"
                                Command="{Binding OpenRepairHistoryCommand}"
                                Background="{DynamicResource VantageCardBrush}" BorderBrush="{DynamicResource VantageBorderBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="18,14" Margin="0,0,0,14"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                Cursor="Hand" ToolTip.Tip="Klik untuk melihat riwayat servis unit ini">
                            <Grid RowDefinitions="Auto,Auto,Auto">
                                <TextBlock Grid.Row="0" Text="{Binding ConditionTitle}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource VantageTextMutedBrush}" HorizontalAlignment="Center" />

                                <!-- Circular Ring Meter: Dynamic Arc based on ConditionSweepAngle -->
                                <Grid Grid.Row="1" Width="76" Height="76" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,8">
                                    <Ellipse Width="76" Height="76" Stroke="{DynamicResource VantageBorderBrush}" StrokeThickness="6" />
                                    <Arc Width="76" Height="76" Stroke="{DynamicResource VantageAccentHoverBrush}" StrokeThickness="6" StrokeLineCap="Round"
                                         StartAngle="-90" SweepAngle="{Binding ConditionSweepAngle}" />
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ConditionDisplay}" FontWeight="Black" FontSize="16" Foreground="{DynamicResource VantageTextBrush}" HorizontalAlignment="Center" />
                                        <PathIcon Data="{StaticResource IconHistory}" Foreground="{DynamicResource VantageTextMutedBrush}" Width="11" Height="11" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel Grid.Row="2" Spacing="2">
                                    <TextBlock Text="{Binding ConditionStatus}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource VantageTextBrush}"
                                               TextAlignment="Center" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" Margin="0,2,0,0">
                                        <TextBlock Text="Lihat Riwayat Servis" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource VantageTextMutedBrush}" />
                                        <PathIcon Data="{StaticResource IconChevronRight}" Foreground="{DynamicResource VantageTextMutedBrush}" Width="10" Height="10" VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- Card 2: Penyimpanan (Storage) - Clickable to Detail -->
                        <Button Grid.Row="1"
                                Command="{Binding OpenStorageDetailCommand}"
                                Background="{DynamicResource VantageCardBrush}" BorderBrush="{DynamicResource VantageBorderBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="18,14"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                Cursor="Hand" ToolTip.Tip="Klik untuk melihat spesifikasi detail penyimpanan &amp; benchmark">
                            <Grid RowDefinitions="Auto,Auto,Auto">
                                <TextBlock Grid.Row="0" Text="Penyimpanan (Storage)" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource VantageTextMutedBrush}" HorizontalAlignment="Center" />

                                <!-- Circular Ring Meter: Dynamic Storage Arc -->
                                <Grid Grid.Row="1" Width="76" Height="76" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,8">
                                    <Ellipse Width="76" Height="76" Stroke="{DynamicResource VantageBorderBrush}" StrokeThickness="6" />
                                    <Arc Width="76" Height="76" Stroke="{DynamicResource VantageAccentBrush}" StrokeThickness="6" StrokeLineCap="Round"
                                         StartAngle="-90" SweepAngle="{Binding StorageSweepAngle}" />
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StoragePercent, StringFormat='{}{0}%'}" FontWeight="Black" FontSize="16" Foreground="{DynamicResource VantageTextBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="Terpakai" FontSize="10" Foreground="{DynamicResource VantageTextMutedBrush}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel Grid.Row="2" Spacing="2">
                                    <TextBlock Text="{Binding StorageDisplay}" FontSize="13" FontWeight="SemiBold"
                                               FontFamily="Consolas,Monospace" Foreground="{DynamicResource VantageTextBrush}"
                                               TextAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" Margin="0,2,0,0">
                                        <TextBlock Text="Lihat Spek Storage" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource VantageTextMutedBrush}" />
                                        <PathIcon Data="{StaticResource IconChevronRight}" Foreground="{DynamicResource VantageTextMutedBrush}" Width="10" Height="10" VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Button>
                    </Grid>

                    <!-- ============================================== -->
                    <!-- COL 2: Garansi Resmi & Memori RAM              -->
                    <!-- ============================================== -->
                    <Grid Grid.Column="2" RowDefinitions="*,*">
                        <!-- Card 3: Garansi Resmi (Warranty Status) -->
                        <Border Grid.Row="0"
                                Background="{DynamicResource VantageCardBrush}" BorderBrush="{DynamicResource VantageBorderBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="18,14" Margin="0,0,0,14">
                            <Grid RowDefinitions="Auto,Auto,Auto">
                                <TextBlock Grid.Row="0" Text="Garansi Resmi PT JTS" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource VantageTextMutedBrush}" HorizontalAlignment="Center" />

                                <!-- Circular Shield Ring Meter: Refined Blue Ring when active -->
                                <Grid Grid.Row="1" Width="76" Height="76" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,8">
                                    <Ellipse Width="76" Height="76" Stroke="{DynamicResource VantageBorderBrush}" StrokeThickness="6" />
                                    <Arc Width="76" Height="76" Stroke="{DynamicResource VantageAccentBrush}" StrokeThickness="6" StrokeLineCap="Round"
                                         StartAngle="-90" SweepAngle="{Binding WarrantySweepAngle}" />
                                    <PathIcon Data="{StaticResource IconShield}" Foreground="{DynamicResource VantageAccentBrush}"
                                              Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>

                                <StackPanel Grid.Row="2" Spacing="2">
                                    <TextBlock Text="{Binding WarrantyRemainingText}" FontSize="13" FontWeight="Bold"
                                               Foreground="{DynamicResource VantageTextBrush}" TextAlignment="Center" />
                                    <TextBlock Text="{Binding StatusLabel}" FontSize="10" FontWeight="Bold" FontFamily="Consolas,Monospace"
                                               Foreground="{DynamicResource VantageTextMutedBrush}" TextAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Card 4: Memori RAM - Clickable to Detail -->
                        <Button Grid.Row="1"
                                Command="{Binding OpenRamDetailCommand}"
                                Background="{DynamicResource VantageCardBrush}" BorderBrush="{DynamicResource VantageBorderBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="18,14"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                Cursor="Hand" ToolTip.Tip="Klik untuk melihat detail alokasi &amp; frekuensi RAM">
                            <Grid RowDefinitions="Auto,Auto,Auto">
                                <TextBlock Grid.Row="0" Text="Memori RAM" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource VantageTextMutedBrush}" HorizontalAlignment="Center" />

                                <!-- Circular Ring Meter: Dynamic RAM Arc -->
                                <Grid Grid.Row="1" Width="76" Height="76" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,8">
                                    <Ellipse Width="76" Height="76" Stroke="{DynamicResource VantageBorderBrush}" StrokeThickness="6" />
                                    <Arc Width="76" Height="76" Stroke="{DynamicResource VantageAccentBrush}" StrokeThickness="6" StrokeLineCap="Round"
                                         StartAngle="-90" SweepAngle="{Binding MemorySweepAngle}" />
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding MemoryPercent, StringFormat='{}{0}%'}" FontWeight="Black" FontSize="16" Foreground="{DynamicResource VantageTextBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="Terpakai" FontSize="10" Foreground="{DynamicResource VantageTextMutedBrush}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel Grid.Row="2" Spacing="2">
                                    <TextBlock Text="{Binding MemoryDisplay}" FontSize="13" FontWeight="SemiBold"
                                               FontFamily="Consolas,Monospace" Foreground="{DynamicResource VantageTextBrush}"
                                               TextAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" Margin="0,2,0,0">
                                        <TextBlock Text="Lihat Spek RAM" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource VantageTextMutedBrush}" />
                                        <PathIcon Data="{StaticResource IconChevronRight}" Foreground="{DynamicResource VantageTextMutedBrush}" Width="10" Height="10" VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Button>
                    </Grid>

                </Grid>

                <!-- Mini Active Repair Notification Banner -->
                <Border IsVisible="{Binding HasActiveRepair}"
                        Background="{DynamicResource VantageAccentSubtleBrush}" BorderBrush="{DynamicResource VantageAccentBrush}" BorderThickness="1.5"
                        CornerRadius="10" Padding="16,12" Margin="0,4,0,0">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Grid.Column="0" Width="36" Height="36" Background="{DynamicResource VantageCardBrush}" CornerRadius="8" Margin="0,0,12,0">
                            <PathIcon Data="{StaticResource IconTracking}" Foreground="{DynamicResource VantageAccentLightBrush}" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Unit Sedang Dalam Pengerjaan Workshop Service Center" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource VantageTextBrush}" />
                            <TextBlock Text="Teknisi sedang melakukan tindakan perbaikan. Pantau tahapan pengerjaan dan estimasi selesai." FontSize="11" Foreground="{DynamicResource VantageTextMutedBrush}" />
                        </StackPanel>
                        <Button Grid.Column="2" Command="{Binding OpenRepairHistoryCommand}"
                                Background="{DynamicResource VantageAccentBrush}" Foreground="White"
                                CornerRadius="8" Padding="14,8" FontSize="12" FontWeight="Bold" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Pantau Linimasa" VerticalAlignment="Center" />
                                <PathIcon Data="{StaticResource IconChevronRight}" Foreground="White" Width="10" Height="10" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- ══════════════════════════════════════════════════════════ -->
                <!-- BOTTOM ROW: Layanan Servis Cepat + System Specs & Dukungan  -->
                <!-- ══════════════════════════════════════════════════════════ -->
                <Grid ColumnDefinitions="1*,1.15*" Margin="0,8,0,0">

                    <!-- ============================================== -->
                    <!-- LEFT: Layanan Servis & Bantuan JTS             -->
                    <!-- ============================================== -->
                    <Border Grid.Column="0"
                            Background="{DynamicResource VantageCardBrush}" BorderBrush="{DynamicResource VantageBorderBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="18,16" Margin="0,0,10,0">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{StaticResource IconService}" Foreground="{DynamicResource VantageAccentBrush}" Width="16" Height="16" VerticalAlignment="Center" />
                                <TextBlock Text="Layanan Servis &amp; Tindakan Cepat" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource VantageTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Link 1: Bantuan Servis & Remote Support -->
                            <Button Command="{Binding GoToClaimCommand}"
                                    Background="{DynamicResource VantageBgBrush}" BorderBrush="{DynamicResource VantageBorderBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="12,10"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Border Grid.Column="0" Width="34" Height="34" Background="{DynamicResource VantageAccentSubtleBrush}" CornerRadius="6" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <PathIcon Data="{StaticResource IconMonitor}" Foreground="{DynamicResource VantageAccentBrush}" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,8,0">
                                        <TextBlock Text="Ajukan Bantuan Servis &amp; Remote" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource VantageTextBrush}" TextWrapping="Wrap" />
                                        <TextBlock Text="Bantuan teknisi via RustDesk atau kunjungan on-site" FontSize="11" Foreground="{DynamicResource VantageTextMutedBrush}" TextWrapping="Wrap" LineHeight="15" />
                                    </StackPanel>
                                    <PathIcon Grid.Column="2" Data="{StaticResource IconChevronRight}" Foreground="{DynamicResource VantageAccentBrush}" Width="12" Height="12" VerticalAlignment="Center" />
                                </Grid>
                            </Button>

                            <!-- Link 2: Status & Linimasa Pengerjaan -->
                            <Button Command="{Binding GoToTrackingCommand}"
                                    Background="{DynamicResource VantageBgBrush}" BorderBrush="{DynamicResource VantageBorderBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="12,10"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Border Grid.Column="0" Width="34" Height="34" Background="{DynamicResource VantageAccentSubtleBrush}" CornerRadius="6" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <PathIcon Data="{StaticResource IconTracking}" Foreground="{DynamicResource VantageAccentBrush}" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,8,0">
                                        <TextBlock Text="Pantau Linimasa Workshop" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource VantageTextBrush}" TextWrapping="Wrap" />
                                        <TextBlock Text="Cek 5 tahapan transparan pengerjaan unit" FontSize="11" Foreground="{DynamicResource VantageTextMutedBrush}" TextWrapping="Wrap" LineHeight="15" />
                                    </StackPanel>
                                    <PathIcon Grid.Column="2" Data="{StaticResource IconChevronRight}" Foreground="{DynamicResource VantageAccentBrush}" Width="12" Height="12" VerticalAlignment="Center" />
                                </Grid>
                            </Button>

                            <!-- Link 3: Kalibrasi Lokasi Rumah -->
                            <Button Command="{Binding GoToLocationCommand}"
                                    Background="{DynamicResource VantageBgBrush}" BorderBrush="{DynamicResource VantageBorderBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="12,10"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Border Grid.Column="0" Width="34" Height="34" Background="{DynamicResource VantageAccentSubtleBrush}" CornerRadius="6" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <PathIcon Data="{StaticResource IconLocation}" Foreground="{DynamicResource VantageAccentBrush}" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,8,0">
                                        <TextBlock Text="Kalibrasi Alamat Penjemputan" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource VantageTextBrush}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding LocationSummary}" FontSize="11" Foreground="{DynamicResource VantageTextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <PathIcon Grid.Column="2" Data="{StaticResource IconChevronRight}" Foreground="{DynamicResource VantageAccentBrush}" Width="12" Height="12" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- ============================================== -->
                    <!-- RIGHT: System Specs & Layanan Dukungan PT JTS  -->
                    <!-- ============================================== -->
                    <Border Grid.Column="1"
                            Background="{DynamicResource VantageCardBrush}" BorderBrush="{DynamicResource VantageBorderBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="18,16" Margin="10,0,0,0">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{StaticResource IconShield}" Foreground="{DynamicResource VantageAccentBrush}" Width="16" Height="16" VerticalAlignment="Center" />
                                <TextBlock Text="Informasi Detail Sistem &amp; Dukungan Resmi PT JTS" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource VantageTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>

                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" Margin="0,4,0,0">
                                <!-- Tile 1: OS Description -->
                                <Border Grid.Column="0" Grid.Row="0" Background="{DynamicResource VantageBgBrush}" BorderBrush="{DynamicResource VantageBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,5,5">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="SISTEM OPERASI" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource VantageTextSubtleBrush}" FontFamily="Consolas,Monospace" />
                                        <TextBlock Text="{Binding OsDescription}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource VantageTextBrush}" TextWrapping="Wrap" LineHeight="16" />
                                        <TextBlock Text="Status: Terverifikasi &amp; Siap Pakai" FontSize="10" Foreground="{DynamicResource VantageTextMutedBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <!-- Tile 2: Processor - Clickable to Detail -->
                                <Button Grid.Column="1" Grid.Row="0"
                                        Command="{Binding OpenCpuDetailCommand}"
                                        Background="{DynamicResource VantageBgBrush}" BorderBrush="{DynamicResource VantageBorderBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="5,0,0,5"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                        Cursor="Hand" ToolTip.Tip="Klik untuk melihat detail arsitektur &amp; cache CPU">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Spacing="3" Margin="0,0,6,0">
                                             <TextBlock Text="PROSESOR / CPU" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource VantageTextSubtleBrush}" FontFamily="Consolas,Monospace" />
                                            <TextBlock Text="{Binding ProcessorName}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource VantageTextBrush}" TextWrapping="Wrap" LineHeight="16" />
                                            <TextBlock Text="{Binding ProcessorCores, StringFormat='{}Inti: {0} Cores / Threads'}" FontSize="10" Foreground="{DynamicResource VantageTextMutedBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <PathIcon Grid.Column="1" Data="{StaticResource IconChevronRight}" Foreground="{DynamicResource VantageAccentBrush}" Width="10" Height="10" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>

                                <!-- Tile 3: Garansi Coverage -->
                                <Border Grid.Column="0" Grid.Row="1" Background="{DynamicResource VantageBgBrush}" BorderBrush="{DynamicResource VantageBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,5,5,0">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="CAKUPAN PERLINDUNGAN" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource VantageTextSubtleBrush}" FontFamily="Consolas,Monospace" />
                                        <TextBlock Text="Hardware, RAM &amp; Storage" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource VantageTextBrush}" TextWrapping="Wrap" LineHeight="16" />
                                        <TextBlock Text="Penggantian Sparepart Original JTS" FontSize="10" Foreground="{DynamicResource VantageTextMutedBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <!-- Tile 4: Hotline Support -->
                                <Border Grid.Column="1" Grid.Row="1" Background="{DynamicResource VantageBgBrush}" BorderBrush="{DynamicResource VantageBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="5,5,0,0">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="HOTLINE PELANGGAN" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource VantageTextSubtleBrush}" FontFamily="Consolas,Monospace" />
                                        <TextBlock Text="{Binding SupportContact}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource VantageTextBrush}" TextWrapping="Wrap" LineHeight="16" />
                                        <TextBlock Text="WhatsApp Bantuan Teknis Resmi PT JTS" FontSize="10" Foreground="{DynamicResource VantageTextMutedBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
