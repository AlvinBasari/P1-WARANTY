            <StreamGeometry x:Key="IconWhatsApp">M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01C17.18 3.03 14.69 2 12.04 2zm5.83 14.04c-.24.68-1.4 1.32-1.92 1.37-.52.05-1 .23-3.38-.7-2.86-1.12-4.67-4.06-4.81-4.25-.14-.19-1.15-1.53-1.15-2.92 0-1.39.73-2.08.99-2.36.26-.28.56-.35.75-.35.19 0 .38 0 .54.01.17.01.4-.06.63.48.24.57.82 2 .89 2.15.07.15.12.33.02.53-.1.2-.15.33-.3.51-.15.18-.32.4-.46.54-.15.15-.31.31-.13.62.18.31.8 1.32 1.72 2.14 1.18 1.05 2.17 1.37 2.48 1.52.31.15.49.13.67-.08.18-.21.78-.91.99-1.22.21-.31.42-.26.71-.15.29.11 1.84.87 2.16 1.03.32.16.53.24.61.37.08.13.08.75-.16 1.43z</StreamGeometry>
            <StreamGeometry x:Key="IconCamera">M4 4h3l2-2h6l2 2h3a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2zm8 3a5 5 0 1 0 0 10 5 5 0 0 0 0-10zm0 2a3 3 0 1 1 0 6 3 3 0 0 1 0-6z</StreamGeometry>
            <StreamGeometry x:Key="IconSettings">M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z</StreamGeometry>
            <StreamGeometry x:Key="IconSave">M17 3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V7l-4-4zm-5 16c-1.66 0-3-1.34-3-3s1.34-3 3-3 3 1.34 3 3-1.34 3-3 3zm3-10H5V5h10v4z</StreamGeometry>
            <StreamGeometry x:Key="IconBolt">M7 2v11h3v9l7-12h-4l4-8z</StreamGeometry>
            <StreamGeometry x:Key="IconReceipt">M18 17H6v-2h12v2zm0-4H6v-2h12v2zm0-4H6V7h12v2zM3 22l1.5-1.5L6 22l1.5-1.5L9 22l1.5-1.5L12 22l1.5-1.5L15 22l1.5-1.5L18 22l1.5-1.5L21 22V2l-1.5 1.5L18 2l-1.5 1.5L15 2l-1.5 1.5L12 2l-1.5 1.5L9 2 7.5 3.5 6 2 4.5 3.5 3 2v20z</StreamGeometry>
            <StreamGeometry x:Key="IconDownload">M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z</StreamGeometry>
            <StreamGeometry x:Key="IconInfo">M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z</StreamGeometry>
            <StreamGeometry x:Key="IconLock">M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z</StreamGeometry>
            <StreamGeometry x:Key="IconArrowLeft">M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z</StreamGeometry>

            <!-- Brand Logo Solid Color (Constant Across Themes) -->
            <SolidColorBrush x:Key="VantageJtsLogoBrush" Color="#2563EB" />

            <ResourceDictionary.ThemeDictionaries>
                <!-- ══════════════════════════════════════════════════════════ -->
                <!-- DARK THEME VARIANT (Default Enterprise Dark)               -->
                <!-- ══════════════════════════════════════════════════════════ -->
                <ResourceDictionary x:Key="Dark">
                    <!-- Backgrounds & Surfaces -->
                    <SolidColorBrush x:Key="VantageBgBrush" Color="#0B0D13" />
                    <SolidColorBrush x:Key="VantageSidebarBrush" Color="#11141D" />
                    <SolidColorBrush x:Key="VantageCardBrush" Color="#171B26" />
                    <SolidColorBrush x:Key="VantageCardSubtleBrush" Color="#0B1120" />
                    <SolidColorBrush x:Key="VantageCardHoverBrush" Color="#1E2433" />
                    <SolidColorBrush x:Key="VantageBorderBrush" Color="#262D3D" />
                    <SolidColorBrush x:Key="VantageBorderLightBrush" Color="#374151" />
                    <SolidColorBrush x:Key="VantageInputBgBrush" Color="#11141D" />

                    <!-- Primary & Secondary Accents -->
                    <SolidColorBrush x:Key="VantageAccentBrush" Color="#2563EB" />
                    <SolidColorBrush x:Key="VantageAccentHoverBrush" Color="#3B82F6" />
                    <SolidColorBrush x:Key="VantageAccentLightBrush" Color="#60A5FA" />
                    <SolidColorBrush x:Key="VantageAccentSubtleBrush" Color="#172554" />
                    <SolidColorBrush x:Key="VantageAccentBorderBrush" Color="#1D4ED8" />

                    <!-- High Readability Dark Mode Typography -->
                    <SolidColorBrush x:Key="VantageTextBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="VantageTextMutedBrush" Color="#94A3B8" />
                    <SolidColorBrush x:Key="VantageTextSubtleBrush" Color="#64748B" />

                    <!-- Functional Indicators -->
                    <SolidColorBrush x:Key="VantageGreenBrush" Color="#10B981" />
                    <SolidColorBrush x:Key="VantageGreenSubtleBrush" Color="#064E3B" />
                    <SolidColorBrush x:Key="VantageAmberBrush" Color="#F59E0B" />
                    <SolidColorBrush x:Key="VantageAmberSubtleBrush" Color="#451A03" />
                    <SolidColorBrush x:Key="VantageFaultBrush" Color="#EF4444" />
                    <SolidColorBrush x:Key="VantageFaultSubtleBrush" Color="#450A0A" />

                    <!-- Sidebar Active Tab Tokens -->
                    <SolidColorBrush x:Key="VantageTabActiveBgBrush" Color="#1E293B" />
                    <SolidColorBrush x:Key="VantageTabActiveBorderBrush" Color="#2563EB" />
                    <SolidColorBrush x:Key="VantageTabActiveFgBrush" Color="#3B82F6" />
                    <SolidColorBrush x:Key="VantageTabActiveTextFgBrush" Color="#FFFFFF" />
                </ResourceDictionary>

                <!-- ══════════════════════════════════════════════════════════ -->
                <!-- LIGHT THEME VARIANT (Clean Slate / Modern Enterprise)      -->
                <!-- ══════════════════════════════════════════════════════════ -->
                <ResourceDictionary x:Key="Light">
                    <!-- Backgrounds & Surfaces -->
                    <SolidColorBrush x:Key="VantageBgBrush" Color="#F1F5F9" />
                    <SolidColorBrush x:Key="VantageSidebarBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="VantageCardBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="VantageCardSubtleBrush" Color="#F8FAFC" />
                    <SolidColorBrush x:Key="VantageCardHoverBrush" Color="#E2E8F0" />
                    <SolidColorBrush x:Key="VantageBorderBrush" Color="#CBD5E1" />
                    <SolidColorBrush x:Key="VantageBorderLightBrush" Color="#E2E8F0" />
                    <SolidColorBrush x:Key="VantageInputBgBrush" Color="#FFFFFF" />

                    <!-- Primary & Secondary Accents -->
                    <SolidColorBrush x:Key="VantageAccentBrush" Color="#2563EB" />
                    <SolidColorBrush x:Key="VantageAccentHoverBrush" Color="#1D4ED8" />
                    <SolidColorBrush x:Key="VantageAccentLightBrush" Color="#2563EB" />
                    <SolidColorBrush x:Key="VantageAccentSubtleBrush" Color="#DBEAFE" />
                    <SolidColorBrush x:Key="VantageAccentBorderBrush" Color="#93C5FD" />

                    <!-- High Readability Light Mode Typography -->
                    <SolidColorBrush x:Key="VantageTextBrush" Color="#0F172A" />
                    <SolidColorBrush x:Key="VantageTextMutedBrush" Color="#475569" />
                    <SolidColorBrush x:Key="VantageTextSubtleBrush" Color="#64748B" />

                    <!-- Functional Indicators -->
                    <SolidColorBrush x:Key="VantageGreenBrush" Color="#059669" />
                    <SolidColorBrush x:Key="VantageGreenSubtleBrush" Color="#D1FAE5" />
                    <SolidColorBrush x:Key="VantageAmberBrush" Color="#D97706" />
                    <SolidColorBrush x:Key="VantageAmberSubtleBrush" Color="#FEF3C7" />
                    <SolidColorBrush x:Key="VantageFaultBrush" Color="#DC2626" />
                    <SolidColorBrush x:Key="VantageFaultSubtleBrush" Color="#FEE2E2" />

                    <!-- Sidebar Active Tab Tokens -->
                    <SolidColorBrush x:Key="VantageTabActiveBgBrush" Color="#EFF6FF" />
                    <SolidColorBrush x:Key="VantageTabActiveBorderBrush" Color="#3B82F6" />
                    <SolidColorBrush x:Key="VantageTabActiveFgBrush" Color="#2563EB" />
                    <SolidColorBrush x:Key="VantageTabActiveTextFgBrush" Color="#1E3A8A" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderBrush" Value="{DynamicResource VantageBorderBrush}" />
            <Setter Property="Background" Value="{DynamicResource VantageInputBgBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource VantageTextBrush}" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="TextBox:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource VantageAccentBrush}" />
        </Style>

        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!-- Subtle Card & Tile Hover Interaction -->
        <Style Selector="Border.vantage-card:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource VantageAccentHoverBrush}" />
        </Style>
        <Style Selector="Button.vantage-action-tile:pointerover">
            <Setter Property="Background" Value="{DynamicResource VantageCardHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource VantageAccentHoverBrush}" />
        </Style>

        <!-- Sidebar Navigation Tab Styles (Pure Native Reactive Theme-Aware) -->
        <Style Selector="Button.vantage-nav-tab">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="10,10" />
        </Style>
        <Style Selector="Button.vantage-nav-tab:pointerover">
            <Setter Property="Background" Value="{DynamicResource VantageCardHoverBrush}" />
        </Style>
        <Style Selector="Button.vantage-nav-tab.active">
            <Setter Property="Background" Value="{DynamicResource VantageTabActiveBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource VantageTabActiveBorderBrush}" />
        </Style>

        <Style Selector="Button.vantage-nav-tab PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource VantageTextMutedBrush}" />
        </Style>
        <Style Selector="Button.vantage-nav-tab.active PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource VantageTabActiveFgBrush}" />
        </Style>

        <Style Selector="Button.vantage-nav-tab TextBlock.nav-title">
            <Setter Property="Foreground" Value="{DynamicResource VantageTextMutedBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Button.vantage-nav-tab.active TextBlock.nav-title">
            <Setter Property="Foreground" Value="{DynamicResource VantageTabActiveTextFgBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <!-- Category Selector Tab Styles -->
        <Style Selector="Button.category-tab">
            <Setter Property="Background" Value="{DynamicResource VantageCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource VantageBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.category-tab:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource VantageAccentHoverBrush}" />
        </Style>
        <Style Selector="Button.category-tab.active">
            <Setter Property="Background" Value="{DynamicResource VantageAccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource VantageAccentHoverBrush}" />
        </Style>
        <Style Selector="Button.category-tab PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource VantageTextMutedBrush}" />
        </Style>
        <Style Selector="Button.category-tab.active PathIcon">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.category-tab TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource VantageTextMutedBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Button.category-tab.active TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <!-- Modern Slim Scrollbar -->
        <Style Selector="ScrollBar:vertical">
            <Setter Property="Width" Value="8" />
        </Style>
        <Style Selector="ScrollBar:horizontal">
            <Setter Property="Height" Value="8" />
        </Style>
    </Application.Styles>
</Application>
