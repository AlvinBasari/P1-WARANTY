<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TechnicianApp.ViewModels"
             xmlns:m="using:SharedCore.Models"
             x:Class="TechnicianApp.Views.InvoiceDialog"
             x:DataType="vm:InvoiceManagerViewModel">

    <Grid Background="#B0000000">
        <Border VerticalAlignment="Center" HorizontalAlignment="Center"
                Background="{DynamicResource VantageCardBrush}"
                BorderBrush="{DynamicResource VantageBorderBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="24"
                Width="880"
                MaxHeight="680"
                BoxShadow="0 12 36 0 #40000000">
            <Grid RowDefinitions="Auto,*,Auto">
                <!-- Row 0: Header -->
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="FAKTUR RESMI PERBAIKAN &amp; SUKU CADANG" FontSize="14" FontWeight="Black" LetterSpacing="0.8" Foreground="{DynamicResource VantageTextBrush}"/>
                            <Border Background="{DynamicResource VantageAccentSubtleBrush}" CornerRadius="4" Padding="6,2">
                                <TextBlock Text="{Binding InvoiceNumber}" FontSize="11" FontWeight="Bold" FontFamily="Consolas,Monospace" Foreground="{DynamicResource VantageAccentLightBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Ticket.Id, StringFormat='Faktur klaim garansi untuk Tiket #{0}'}" FontSize="11" Foreground="{DynamicResource VantageTextMutedBrush}"/>
                    </StackPanel>

                    <Button Grid.Column="1" Command="{Binding CloseCommand}"
                            HotKey="Escape"
                            Padding="8,4" Background="Transparent" BorderBrush="Transparent" Cursor="Hand">
                        <TextBlock Text="✕" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource VantageTextMutedBrush}"/>
                    </Button>
                </Grid>

                <!-- Row 1: 2-Column Content -->
                <Grid Grid.Row="1" ColumnDefinitions="1.2*,*">
                    <!-- Left: Item Form & Item List -->
                    <Grid Grid.Column="0" RowDefinitions="Auto,*" Margin="0,0,12,0">
                        <!-- Add Item Form -->
                        <Border Grid.Row="0" Background="{DynamicResource VantageCardSubtleBrush}" BorderBrush="{DynamicResource VantageBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,12">
                            <StackPanel Spacing="8">
                                <TextBlock Text="TAMBAH SUKU CADANG / BIAYA JASA" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource VantageTextSubtleBrush}" LetterSpacing="0.8"/>
                                
                                <Grid ColumnDefinitions="*,100">
                                    <TextBox Grid.Column="0" Text="{Binding NewItemName, Mode=TwoWay}" Watermark="Nama Suku Cadang / Layanan..." FontSize="12" Margin="0,0,6,0"/>
                                    <TextBox Grid.Column="1" Text="{Binding NewItemCode, Mode=TwoWay}" Watermark="Kode Part" FontSize="11" FontFamily="Consolas,Monospace"/>
                                </Grid>

                                <Grid ColumnDefinitions="80,*,Auto">
                                    <TextBox Grid.Column="0" Text="{Binding NewItemQuantity, Mode=TwoWay}" Watermark="Qty" FontSize="12" Margin="0,0,6,0"/>
                                    <TextBox Grid.Column="1" Text="{Binding NewItemUnitPrice, Mode=TwoWay}" Watermark="Harga Satuan (Rp)" FontSize="12" Margin="0,0,8,0"/>
                                    <CheckBox Grid.Column="2" IsChecked="{Binding NewItemIsCovered, Mode=TwoWay}" VerticalAlignment="Center">
                                        <TextBlock Text="Garansi (100% Free)" FontSize="11" FontWeight="SemiBold"/>
                                    </CheckBox>
                                </Grid>

                                <Button Command="{Binding AddItemCommand}"
                                        Background="{DynamicResource VantageAccentBrush}"
                                        Foreground="White"
                                        FontWeight="Bold"
                                        FontSize="11"
                                        Padding="10,7"
                                        HorizontalAlignment="Right">
                                    <TextBlock Text="+ Tambah ke Faktur"/>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Items Table List -->
                        <Border Grid.Row="1" Background="{DynamicResource VantageCardSubtleBrush}" BorderBrush="{DynamicResource VantageBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10">
                            <Grid RowDefinitions="Auto,*">
                                <Grid Grid.Row="0" ColumnDefinitions="*,60,110,Auto" Margin="0,0,0,8">
                                    <TextBlock Grid.Column="0" Text="ITEM / LAYANAN" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource VantageTextSubtleBrush}"/>
                                    <TextBlock Grid.Column="1" Text="QTY" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource VantageTextSubtleBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="TOTAL" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource VantageTextSubtleBrush}" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="3" Text="" Width="30"/>
                                </Grid>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="m:InvoiceItemPayloadDto">
                                                <Border BorderBrush="{DynamicResource VantageBorderBrush}" BorderThickness="0,0,0,1" Padding="0,6" Margin="0,0,0,2">
                                                    <Grid ColumnDefinitions="*,60,110,Auto">
                                                        <StackPanel Grid.Column="0" Spacing="2">
                                                            <TextBlock Text="{Binding ItemName}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource VantageTextBrush}"/>
                                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                                <Border Background="{DynamicResource VantageGreenSubtleBrush}" CornerRadius="3" Padding="4,1" IsVisible="{Binding IsCoveredByWarranty}">
                                                                    <TextBlock Text="GARANSI" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource VantageGreenBrush}"/>
                                                                </Border>
                                                                <TextBlock Text="{Binding Notes}" FontSize="9" Foreground="{DynamicResource VantageTextSubtleBrush}" TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <TextBlock Grid.Column="1" Text="{Binding Quantity}" FontSize="11" Foreground="{DynamicResource VantageTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding UnitPrice, Converter={StaticResource CurrencyFormatConverter}}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource VantageTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                                        <Button Grid.Column="3"
                                                                Command="{Binding $parent[UserControl].((vm:InvoiceManagerViewModel)DataContext).RemoveItemCommand}"
                                                                CommandParameter="{Binding}"
                                                                Padding="4,2"
                                                                Margin="6,0,0,0"
                                                                Background="Transparent"
                                                                BorderBrush="Transparent"
                                                                Foreground="{DynamicResource VantageFaultBrush}"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="✕" FontSize="11" FontWeight="Bold"/>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Right: Summary & Action Panel -->
                    <StackPanel Grid.Column="1" Spacing="12" Margin="12,0,0,0">
                        <!-- Financial Summary Box -->
                        <Border Background="{DynamicResource VantageCardSubtleBrush}" BorderBrush="{DynamicResource VantageBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
                            <StackPanel Spacing="8">
                                <TextBlock Text="RINGKASAN BIAYA &amp; GARANSI" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource VantageTextSubtleBrush}" LetterSpacing="0.8"/>

                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="Subtotal Biaya" FontSize="11" Foreground="{DynamicResource VantageTextMutedBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SubtotalAmount, Converter={StaticResource CurrencyFormatConverter}}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource VantageTextBrush}"/>
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="Potongan Garansi (100%)" FontSize="11" Foreground="{DynamicResource VantageGreenBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding WarrantyDiscountAmount, StringFormat='- {0}', Converter={StaticResource CurrencyFormatConverter}}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource VantageGreenBrush}"/>
                                </Grid>

                                <Separator Background="{DynamicResource VantageBorderBrush}"/>

                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="TAGIHAN KLIEN" FontSize="12" FontWeight="Black" Foreground="{DynamicResource VantageTextBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding TotalPayableAmount, Converter={StaticResource CurrencyFormatConverter}}" FontSize="16" FontWeight="Black" Foreground="{DynamicResource VantageAccentLightBrush}" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Notes & Terms -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Catatan Faktur:" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource VantageTextMutedBrush}"/>
                            <TextBox Text="{Binding Notes, Mode=TwoWay}" FontSize="11" Height="45" AcceptsReturn="True"/>
                        </StackPanel>

                        <!-- Action Buttons -->
                        <StackPanel Spacing="8" Margin="0,8,0,0">
                            <Button Command="{Binding SaveInvoiceCommand}"
                                    Background="{DynamicResource VantageAccentBrush}"
                                    Foreground="White"
                                    FontWeight="Bold"
                                    FontSize="12"
                                    Padding="12,10"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center">
                                <Grid ColumnDefinitions="Auto,*">
                                    <PathIcon Grid.Column="0" Data="{DynamicResource IconCheck}" Width="14" Height="14" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Simpan Faktur Perbaikan" HorizontalAlignment="Center"/>
                                </Grid>
                            </Button>

                            <Button Command="{Binding PrintOrDownloadHtmlCommand}"
                                    Background="{DynamicResource VantageCardSubtleBrush}"
                                    BorderBrush="{DynamicResource VantageBorderBrush}"
                                    BorderThickness="1"
                                    Foreground="{DynamicResource VantageTextBrush}"
                                    FontWeight="SemiBold"
                                    FontSize="11"
                                    Padding="10,8"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center">
                                <Grid ColumnDefinitions="Auto,*">
                                    <PathIcon Grid.Column="0" Data="{DynamicResource IconReceipt}" Width="12" Height="12" Foreground="{DynamicResource VantageGreenBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Buka / Cetak Faktur HTML" HorizontalAlignment="Center"/>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Row 2: Toast Bar -->
                <Border Grid.Row="2"
                        Background="{DynamicResource VantageCardSubtleBrush}"
                        BorderBrush="{DynamicResource VantageAccentBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10,6"
                        Margin="0,12,0,0"
                        IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotNullOrEmptyToBoolConverter}}">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource VantageAccentLightBrush}"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
