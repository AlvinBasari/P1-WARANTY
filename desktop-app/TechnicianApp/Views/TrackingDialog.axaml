<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TechnicianApp.ViewModels"
             xmlns:m="using:SharedCore.Models"
             x:Class="TechnicianApp.Views.TrackingDialog"
             x:DataType="vm:WorkshopTrackingViewModel">

    <Grid Background="#B0000000">
        <Border VerticalAlignment="Center" HorizontalAlignment="Center"
                Background="{DynamicResource VantageCardBrush}"
                BorderBrush="{DynamicResource VantageBorderBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="24"
                Width="680"
                MaxHeight="620"
                BoxShadow="0 12 36 0 #40000000">
            <Grid RowDefinitions="Auto,Auto,*,Auto">
                <!-- Row 0: Header -->
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="PELACAK TAHAPAN WORKSHOP (SERVICE CENTER)" FontSize="13" FontWeight="Black" LetterSpacing="0.8" Foreground="{DynamicResource VantageTextBrush}"/>
                        <TextBlock Text="{Binding Ticket.Id, StringFormat='Unit Perbaikan untuk Tiket #{0}'}" FontSize="11" Foreground="{DynamicResource VantageTextMutedBrush}"/>
                    </StackPanel>

                    <Button Grid.Column="1" Command="{Binding CloseCommand}" Padding="8,4" Background="Transparent" BorderBrush="Transparent" Cursor="Hand">
                        <TextBlock Text="✕" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource VantageTextMutedBrush}"/>
                    </Button>
                </Grid>

                <!-- Row 1: 5-Stage Visual Stepper Indicators -->
                <Border Grid.Row="1" Background="{DynamicResource VantageCardSubtleBrush}" BorderBrush="{DynamicResource VantageBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,16">
                    <Grid ColumnDefinitions="*,*,*,*,*">
                        <!-- Stage 1 -->
                        <StackPanel Grid.Column="0" Spacing="4" HorizontalAlignment="Center">
                            <Border Width="28" Height="28" CornerRadius="14"
                                    Background="{Binding IsStep1Completed, Converter={x:Static ObjectConverters.IsNull}}"
                                    HorizontalAlignment="Center">
                                <TextBlock Text="1" FontSize="11" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Dijemput" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource VantageTextBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Stage 2 -->
                        <StackPanel Grid.Column="1" Spacing="4" HorizontalAlignment="Center">
                            <Border Width="28" Height="28" CornerRadius="14"
                                    Background="{DynamicResource VantageAccentBrush}"
                                    HorizontalAlignment="Center">
                                <TextBlock Text="2" FontSize="11" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Di Workshop" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource VantageTextBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Stage 3 -->
                        <StackPanel Grid.Column="2" Spacing="4" HorizontalAlignment="Center">
                            <Border Width="28" Height="28" CornerRadius="14"
                                    Background="{DynamicResource VantageAccentBrush}"
                                    HorizontalAlignment="Center">
                                <TextBlock Text="3" FontSize="11" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Perbaikan" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource VantageTextBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Stage 4 -->
                        <StackPanel Grid.Column="3" Spacing="4" HorizontalAlignment="Center">
                            <Border Width="28" Height="28" CornerRadius="14"
                                    Background="{DynamicResource VantageAccentBrush}"
                                    HorizontalAlignment="Center">
                                <TextBlock Text="4" FontSize="11" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Pengujian" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource VantageTextBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Stage 5 -->
                        <StackPanel Grid.Column="4" Spacing="4" HorizontalAlignment="Center">
                            <Border Width="28" Height="28" CornerRadius="14"
                                    Background="{DynamicResource VantageGreenBrush}"
                                    HorizontalAlignment="Center">
                                <TextBlock Text="5" FontSize="11" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Kembali" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource VantageTextBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Row 2: Status Advance Actions & History Timeline -->
                <Grid Grid.Row="2" ColumnDefinitions="*,*" Margin="0,0,0,16">
                    <!-- Left: Advance Stage Form -->
                    <StackPanel Grid.Column="0" Spacing="10" Margin="0,0,10,0">
                        <TextBlock Text="PERBARUI TAHAPAN SEKARANG" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource VantageTextMutedBrush}" LetterSpacing="0.8"/>
                        
                        <TextBox Text="{Binding NewNotes, Mode=TwoWay}"
                                 Watermark="Catatan teknisi (contoh: part telah diganti &amp; lolos uji bench...)"
                                 AcceptsReturn="True"
                                 Height="70"
                                 FontSize="12"/>

                        <TextBlock Text="Pilih Status Baru:" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource VantageTextSubtleBrush}"/>
                        <WrapPanel>
                            <Button Command="{Binding AdvanceStepCommand}" CommandParameter="di_service_center"
                                    Background="{DynamicResource VantageCardSubtleBrush}" BorderBrush="{DynamicResource VantageBorderBrush}" BorderThickness="1"
                                    Foreground="{DynamicResource VantageTextBrush}" FontSize="10" FontWeight="Bold" Padding="8,5" Margin="2">
                                <TextBlock Text="➔ Tiba di SC"/>
                            </Button>

                            <Button Command="{Binding AdvanceStepCommand}" CommandParameter="sedang_diperbaiki"
                                    Background="{DynamicResource VantageCardSubtleBrush}" BorderBrush="{DynamicResource VantageBorderBrush}" BorderThickness="1"
                                    Foreground="{DynamicResource VantageTextBrush}" FontSize="10" FontWeight="Bold" Padding="8,5" Margin="2">
                                <TextBlock Text="➔ Sedang Diperbaiki"/>
                            </Button>

                            <Button Command="{Binding AdvanceStepCommand}" CommandParameter="selesai"
                                    Background="{DynamicResource VantageCardSubtleBrush}" BorderBrush="{DynamicResource VantageBorderBrush}" BorderThickness="1"
                                    Foreground="{DynamicResource VantageGreenBrush}" FontSize="10" FontWeight="Bold" Padding="8,5" Margin="2">
                                <TextBlock Text="➔ Pengujian / Selesai"/>
                            </Button>

                            <Button Command="{Binding AdvanceStepCommand}" CommandParameter="dikembalikan"
                                    Background="{DynamicResource VantageGreenSubtleBrush}" BorderBrush="{DynamicResource VantageGreenBrush}" BorderThickness="1"
                                    Foreground="{DynamicResource VantageGreenBrush}" FontSize="10" FontWeight="Bold" Padding="8,5" Margin="2">
                                <TextBlock Text="➔ Dikembalikan ke Klien"/>
                            </Button>
                        </WrapPanel>
                    </StackPanel>

                    <!-- Right: History Timeline -->
                    <Border Grid.Column="1" Background="{DynamicResource VantageCardSubtleBrush}" BorderBrush="{DynamicResource VantageBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="10,0,0,0">
                        <Grid RowDefinitions="Auto,*">
                            <TextBlock Grid.Row="0" Text="RIWAYAT PERJALANAN UNIT" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource VantageTextMutedBrush}" Margin="0,0,0,8"/>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Histories}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="m:RepairTrackingHistoryDto">
                                            <Border BorderBrush="{DynamicResource VantageBorderBrush}" BorderThickness="0,0,0,1" Padding="0,4,0,6" Margin="0,0,0,4">
                                                <StackPanel Spacing="2">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Grid.Column="0" Text="{Binding Status, Converter={StaticResource StatusTextConverter}}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource VantageAccentLightBrush}"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding CreatedAt}" FontSize="9" Foreground="{DynamicResource VantageTextSubtleBrush}"/>
                                                    </Grid>
                                                    <TextBlock Text="{Binding Notes}" FontSize="10" Foreground="{DynamicResource VantageTextBrush}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Row 3: Footer Status & Close -->
                <Grid Grid.Row="3" ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource VantageAccentLightBrush}" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Command="{Binding CloseCommand}" Background="{DynamicResource VantageAccentBrush}" Foreground="White" FontWeight="Bold" FontSize="12" Padding="16,8">
                        <TextBlock Text="Tutup Dialog"/>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
